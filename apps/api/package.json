{
  "name": "@movie-talkin/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@movie-talkin/shared": "workspace:*",
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.43.1",
    "hono": "^4.7.10",
    "zod": "^3.24.2",
    "@hono/zod-validator": "^0.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.14",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
